[Unit]
Description=Sony Pi Camera browser viewer for %i
Requires=sony-pi-camera@%i.service
After=sony-pi-camera@%i.service

[Service]
Type=simple
User=%i
Group=sony-camera-viewer
UMask=0077
WorkingDirectory=/opt/pi-camera/sidedoor
ExecStart=/usr/bin/env node /opt/pi-camera/sidedoor/web/server.mjs
EnvironmentFile=/etc/sony-pi-viewer-%i.conf
StateDirectory=sony-pi-camera-%i
StateDirectoryMode=0700
RuntimeDirectory=sony-camera-%i
RuntimeDirectoryMode=0750
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=on-failure

[Install]
WantedBy=multi-user.target
