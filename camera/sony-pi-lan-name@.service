[Unit]
Description=Advertise the Sony Camera Wi-Fi viewer for %i
Requires=avahi-daemon.service
After=avahi-daemon.service
PartOf=avahi-daemon.service

[Service]
User=%i
EnvironmentFile=/etc/sony-pi-viewer-%i.conf
ExecStart=/bin/sh /opt/pi-camera/publish-lan-name.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
